{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ANALYZE",
        "SUPABASE_PROJECT_REF",
        "SUPABASE_ADMIN",
        "RESEND_API_KEY",
        "RESEND_DOMAIN",
        "RECAPTCHA_SECRET_KEY",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
